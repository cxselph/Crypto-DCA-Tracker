# Optional: copy to .env in the stack folder on the NAS (never commit .env). compose.yaml reads it.
# The Home Auth username allowed in (only this one person). Without it, Home Auth sign-in is refused.
HOME_AUTH_USER=
# Your time zone, for the nightly backup time.
# TZ=America/Detroit
# When the nightly backup runs (24-hour local time).
# NIGHTLY_BACKUP_TIME=02:30
# Session cookies are signed with a random key the app makes in data/secret.key on first start.
# Set SECRET_KEY only to use your own; changing it (or deleting secret.key) signs every device out.
# SECRET_KEY=
