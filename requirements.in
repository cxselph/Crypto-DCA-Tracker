# Direct dependencies. requirements.txt is the hashed lockfile to install from; regenerate it with
#   uv pip compile requirements.in --generate-hashes --python-version 3.14 \
#     --python-platform aarch64-apple-darwin --exclude-newer <date ~14 days ago> -o requirements.txt
# (No uv installed? Run it from the pinned image:
#   docker run --rm -v "$PWD:/w" -w /w ghcr.io/astral-sh/uv:0.12.15-trixie-slim@sha256:01db3cd653df8521c36836516a381f653d09a35631876ce367fc076ba02da4b4 uv pip compile …)
